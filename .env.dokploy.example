# Environment template for Dokploy deployment (compose-dokploy.yaml)
# Paste these into Dokploy → Environment tab and fill real values.

# --- database ---
POSTGRES_DB=mission_control
POSTGRES_USER=postgres
# REQUIRED: set a strong password
POSTGRES_PASSWORD=

# --- backend ---
# REQUIRED: frontend origin for CORS (your frontend URL)
CORS_ORIGINS=https://your-frontend-domain.com
DB_AUTO_MIGRATE=true
LOG_LEVEL=INFO
AUTH_MODE=local
# REQUIRED when AUTH_MODE=local (≥50 chars)
LOCAL_AUTH_TOKEN=

# --- frontend ---
# REQUIRED: public API URL (browser calls this). Set before first deploy.
NEXT_PUBLIC_API_URL=https://your-backend-domain.com

# --- worker (optional) ---
RQ_QUEUE_NAME=default
RQ_DISPATCH_THROTTLE_SECONDS=2.0
RQ_DISPATCH_MAX_RETRIES=3
